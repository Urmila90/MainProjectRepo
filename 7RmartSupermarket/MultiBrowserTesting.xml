<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE suite SYSTEM "https://testng.org/testng-1.0.dtd">
<suite name="Multi Browser Testing" parallel="tests">
	<test thread-count="5" name="Chrome Test">
		<parameter name="browser" value="chrome"></parameter>
		<classes>
			<class name="testscript1.ManageNewsTest">
				<methods>
					<include name="ManageNewsPageIsLoadedWhenMoreInfoClicked"></include>
				</methods>
			</class>
			<class name="testscript1.LoginTest" />
			<class name="testscript1.ManageDeliveryBoyTest" />
			<class name="testscript1.HomeTest" />
			<class name="testscript1.CategoryTest" />
			<class name="testscript1.ManageLocationTest" />
			<class name="testscript1.AdminUsersTest" />
		</classes>
	</test> <!--
	Test -->

	<test thread-count="5" name="Edge Test">
		<parameter name="browser" value="edge"></parameter>
		<classes>
			<class name="testscript1.ManageNewsTest">
				<methods>
					<include name="ManageNewsPageIsLoadedWhenMoreInfoClicked"></include>
				</methods>
			</class>
			<class name="testscript1.LoginTest" />
			<class name="testscript1.ManageDeliveryBoyTest" />
			<class name="testscript1.HomeTest" />
			<class name="testscript1.CategoryTest" />
			<class name="testscript1.ManageLocationTest" />
			<class name="testscript1.AdminUsersTest" />
		</classes>
	</test> <!--
	Test -->
</suite> <!--
Suite -->
